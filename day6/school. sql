-- Index to speed up searches by course.
CREATE INDEX idx_enrolments_course_id ON enrolments(course_id);

-- QUERY 1: All courses for one student (by name).
SELECT s.name AS student_name, c.course_name, c.course_code, e.grade
FROM students AS s
JOIN enrolments AS e ON e.student_id = s.student_id
JOIN courses AS c ON c.course_id = e.course_id
WHERE s.name = 'Brian Billion'
ORDER BY c.course_name;

-- QUERY 2: All students on one course.
SELECT c.course_name, s.name AS student_name, s.email, e.grade
FROM courses AS c
JOIN enrolments AS e ON e.course_id = c.course_id
JOIN students AS s ON s.student_id = e.student_id
WHERE c.course_name = 'Business Management'
ORDER BY s.name;

-- QUERY 3: Number of students per course, including courses with zero enrolments.
SELECT c.course_name, COUNT(e.student_id) AS student_count
FROM courses AS c
LEFT JOIN enrolments AS e ON e.course_id = c.course_id
GROUP BY c.course_id, c.course_name
ORDER BY c.course_name;

-- QUERY 4: Students who have no enrolments.
SELECT s.student_id, s.name, s.email
FROM students AS s
LEFT JOIN enrolments AS e ON e.student_id = s.student_id
WHERE e.enrolment_id IS NULL
ORDER BY s.name;

-- QUERY 5: Update one enrolment's grade.
UPDATE enrolments
SET grade = 'B'
WHERE enrolment_id = 5;

-- Verification of the grade update.
SELECT e.enrolment_id, s.name AS student_name, c.course_name, e.grade
FROM enrolments AS e
JOIN students AS s ON s.student_id = e.student_id
JOIN courses AS c ON c.course_id = e.course_id
WHERE e.enrolment_id = 5;
